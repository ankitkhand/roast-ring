# Optional. The app uses its safe local battle engine when this is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Public canonical origin used for metadata and share links in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional GA4 Measurement ID. Analytics stays disabled when this is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# auto = OpenAI when configured, otherwise local. Also accepts openai or local.
AI_PROVIDER=auto

# Battle security storage.
# memory = local development or a temporary SINGLE-INSTANCE beta only.
# redis = required before multiple replicas, autoscaling, multi-region, or serverless deployment.
BATTLE_STORE=memory

# Required only when BATTLE_STORE=redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required in production for BOTH memory and redis modes.
# Use a long random value to HMAC anonymous session/network keys.
RATE_LIMIT_HASH_SECRET=

# Set only to a forwarding header guaranteed and overwritten by your deployment platform.
# Supported: x-vercel-forwarded-for, cf-connecting-ip, x-real-ip
TRUSTED_IP_HEADER=

# Optional beta-limit overrides. Safe defaults are 3/session and 10/network per 10 minutes,
# 15/session and 100/network per day, with a 45-minute battle TTL.
# BATTLE_SESSION_SHORT_MAX=3
# BATTLE_SESSION_SHORT_WINDOW_SECONDS=600
# BATTLE_SESSION_DAILY_MAX=15
# BATTLE_IP_SHORT_MAX=10
# BATTLE_IP_SHORT_WINDOW_SECONDS=600
# BATTLE_IP_DAILY_MAX=100
# BATTLE_TTL_SECONDS=2700
# BATTLE_ACTION_LOCK_MS=60000
